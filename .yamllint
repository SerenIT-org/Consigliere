---
extends: default

rules:
  line-length:
    max: 120
    level: warning
  truthy:
    allowed-values: ["true", "false", "yes", "no"]
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1

# stacks/wazuh/vendor/ is a vendored third-party submodule, not ours to lint
ignore: |
  .github/
  stacks/wazuh/vendor/
