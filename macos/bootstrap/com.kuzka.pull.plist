<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kuzka.pull</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>bash</string>
    <string>-lc</string>
    <!-- macOS ansible-pull equivalent: no systemd, so this just does a
         plain git pull + local ansible-playbook run against macos/site.yml.
         %KUZKA_REPO_DIR% is substituted by bootstrap.sh at install time. -->
    <string>cd %KUZKA_REPO_DIR% && git pull --ff-only && ansible-playbook -i localhost, macos/site.yml</string>
  </array>

  <key>StartInterval</key>
  <integer>1200</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/kuzka-pull.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/kuzka-pull.log</string>
</dict>
</plist>
