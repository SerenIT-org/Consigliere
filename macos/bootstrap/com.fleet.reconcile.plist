<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fleet.reconcile</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>bash</string>
    <string>-lc</string>
    <!-- No systemd on macOS, so this just does a plain git pull + local
         ansible-playbook run against macos/site.yml. No private fleet-config
         repo is wired in here yet -- nothing on the macOS side needs secrets
         or site-specific vars today (see hosts/bootstrap/reconcile.sh for
         the two-repo pattern this would follow if that changes).
         %FRAMEWORK_REPO_DIR% is substituted by bootstrap.sh at install time. -->
    <string>cd %FRAMEWORK_REPO_DIR% && git pull --ff-only && ansible-playbook -i localhost, macos/site.yml</string>
  </array>

  <key>StartInterval</key>
  <integer>1200</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/fleet-reconcile.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/fleet-reconcile.log</string>
</dict>
</plist>
