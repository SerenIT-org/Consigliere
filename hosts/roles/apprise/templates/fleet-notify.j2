#!/usr/bin/env bash
# Managed by Ansible (hosts/roles/apprise).
# fleet-notify "<title>" ["<body>"]     (body is read from stdin if omitted)
set -u
title="${1:-notification}"
body="${2:-}"
[ -n "$body" ] || { [ -t 0 ] || body="$(cat)"; }
[ -n "$body" ] || body="(no details)"
exec {{ apprise_venv }}/bin/apprise -c {{ apprise_config_dir }}/apprise.yml \
  -t "[{{ apprise_title_prefix }}] $title" -b "$body"
