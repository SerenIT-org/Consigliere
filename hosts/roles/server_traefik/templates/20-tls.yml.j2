# Managed by Ansible (hosts/roles/server_traefik) -- edits get overwritten.
# Certificates are files written by agent_certwarden (or any issuer) under
# {{ server_traefik_certs_dir }}, mounted read-only at /certs in the container.
# Touching this file makes Traefik's file provider reload them after renewal.
{% if server_traefik_certificates | length == 0 %}
{}
{% else %}
tls:
  certificates:
{% for c in server_traefik_certificates %}
    - certFile: /certs/{{ c }}/fullchain.pem
      keyFile: /certs/{{ c }}/privkey.pem
{% endfor %}
{% endif %}
