#!/usr/bin/env bash
# Managed by Ansible (hosts/roles/backup) -- edits here get overwritten on
# the next reconciliation run. Change backup_paths/backup_retention in your
# fleet-config repo instead.
set -euo pipefail

source /etc/restic.env

restic backup \
{% for path in backup_paths %}
  {{ path }} \
{% endfor %}
  --tag "{{ inventory_hostname }}"

restic forget \
  --keep-daily {{ backup_retention.daily }} \
  --keep-weekly {{ backup_retention.weekly }} \
  --keep-monthly {{ backup_retention.monthly }} \
  --prune
