# Managed by Ansible (hosts/roles/server_semaphore) -- edits get overwritten.
services:
  semaphore:
    image: semaphoreui/semaphore:{{ server_semaphore_version }}
    container_name: semaphore
    restart: unless-stopped
{% if server_semaphore_network %}
    networks:
      - {{ server_semaphore_network }}
{% else %}
    ports:
      - "{{ server_semaphore_port }}:3000"
{% endif %}
    environment:
      SEMAPHORE_DB_DIALECT: sqlite
      SEMAPHORE_DB: /etc/semaphore/semaphore.sqlite
      SEMAPHORE_ADMIN: "{{ server_semaphore_admin_name }}"
      SEMAPHORE_ADMIN_NAME: "{{ server_semaphore_admin_name }}"
      SEMAPHORE_ADMIN_EMAIL: "{{ server_semaphore_admin_email }}"
      SEMAPHORE_ADMIN_PASSWORD: "{{ server_semaphore_admin_password }}"
      SEMAPHORE_ACCESS_KEY_ENCRYPTION: "{{ server_semaphore_access_key_encryption }}"
      SEMAPHORE_PLAYBOOK_PATH: /tmp/semaphore/
    volumes:
      - semaphore-config:/etc/semaphore
      - semaphore-data:/var/lib/semaphore

volumes:
  semaphore-config:
  semaphore-data:
{% if server_semaphore_network %}

networks:
  {{ server_semaphore_network }}:
    external: true
{% endif %}
