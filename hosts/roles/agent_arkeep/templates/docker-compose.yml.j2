# Managed by Ansible (hosts/roles/agent_arkeep) -- edits here get
# overwritten on the next reconciliation run. Change the role's defaults/
# fleet-config vars instead. Reproduces arkeep-io/arkeep's own
# deploy/docker/docker-compose.agent.yml (verified 2026-10-01).
services:
  agent:
    image: ghcr.io/arkeep-io/arkeep-agent:latest
    container_name: arkeep-agent
    restart: unless-stopped
    environment:
      ARKEEP_SERVER_ADDR: "{{ server_arkeep_addr }}"
      ARKEEP_AGENT_SECRET: "{{ agent_arkeep_secret }}"
      ARKEEP_SERVER_HTTP_ADDR: "{{ agent_arkeep_server_http_addr }}"
      ARKEEP_STATE_DIR: /var/lib/arkeep-agent
      ARKEEP_LOG_LEVEL: "{{ agent_arkeep_log_level }}"
      TZ: "{{ ansible_date_time.tz | default('UTC') }}"
      # gRPC TLS: auto-enrollment (default) -- the agent calls the server's
      # HTTP API on first boot for a signed client cert, reused afterward.
    volumes:
      - arkeep-agent-data:/var/lib/arkeep-agent
      - /:/hostfs:ro
      # :rw so Arkeep's pre/post-backup hooks can stop/start containers via
      # the Docker API -- change to :ro if you don't use hook-based control.
      - /var/run/docker.sock:/var/run/docker.sock:rw
      - /var/lib/docker/volumes:/var/lib/docker/volumes:ro
{% for path in agent_arkeep_backup_paths %}
      - "{{ path }}:/backup{{ path }}:ro"
{% endfor %}

volumes:
  arkeep-agent-data:
    driver: local
