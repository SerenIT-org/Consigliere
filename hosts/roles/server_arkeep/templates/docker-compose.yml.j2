# Managed by Ansible (hosts/roles/server_arkeep) -- edits here get
# overwritten on the next reconciliation run. Change the role's defaults/
# fleet-config vars instead. Reproduces arkeep-io/arkeep's own
# deploy/docker/docker-compose.yml (verified 2026-10-01).
services:
  server:
    image: ghcr.io/arkeep-io/arkeep-server:latest
    container_name: arkeep-server
    restart: unless-stopped
    ports:
{% set bind = (server_arkeep_bind_address ~ ':') if server_arkeep_bind_address else '' %}
      - "{{ bind }}{{ server_arkeep_grpc_port }}:9090"   # gRPC (agents)
{% if server_arkeep_network %}
      - "127.0.0.1:{{ server_arkeep_http_port }}:8080"   # REST API + GUI -- reached via the proxy's shared network, not this host port
{% else %}
      - "{{ bind }}{{ server_arkeep_http_port }}:8080"   # REST API + GUI
{% endif %}
    environment:
      ARKEEP_SECRET_KEY: "{{ server_arkeep_secret_key }}"
      ARKEEP_AGENT_SECRET: "{{ agent_arkeep_secret }}"
      ARKEEP_DATA_DIR: /var/lib/arkeep/data
      ARKEEP_DB_DRIVER: sqlite
      ARKEEP_DB_DSN: /var/lib/arkeep/arkeep.db
      ARKEEP_HTTP_ADDR: ":8080"
      ARKEEP_GRPC_ADDR: ":9090"
      ARKEEP_LOG_LEVEL: "{{ server_arkeep_log_level }}"
      ARKEEP_BASE_URL: "{{ server_arkeep_base_url }}"
      TZ: "{{ ansible_date_time.tz | default('UTC') }}"
      # gRPC TLS: auto-PKI (default) -- the server generates its own CA and
      # cert under the data dir on first boot; agents auto-enroll with mTLS.
      # No external cert wired up here -- see Arkeep's own docs if that's needed.
    volumes:
      - arkeep-data:/var/lib/arkeep
{% if server_arkeep_network %}
    networks:
      - {{ server_arkeep_network }}
{% endif %}
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:8080/health/ready"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

volumes:
  arkeep-data:
    driver: local
{% if server_arkeep_network %}

networks:
  {{ server_arkeep_network }}:
    external: true
{% endif %}
